ROOM_NAME=Kitchen
MULTIROOM_NAME=Multiroom
SNAPSERVER=snapserver.local
ALSA_SINK=default
DOWNMIX_TO_MONO=0
AUDIO_DEVICE=/dev/snd
AUDIO_GID=29

# Resolver for the container, pinned so it does not inherit a half-configured
# host /etc/resolv.conf at boot (see the dns: comment in compose.yml). Set this
# to the LAN resolver; leave empty to keep Docker's default behaviour.
DNS_SERVERS=

ENABLE_SNAPCLIENT=1
ENABLE_SNAPSERVER=0
ENABLE_SPOTIFY=1
ENABLE_UPNP=1

SPOTIFY_INITIAL_VOLUME=70
MULTIROOM_SPOTIFY_INITIAL_VOLUME=100
SPOTIFYD_DEVICE=audio_output
UPNP_DEVICE=

ENABLE_AUDIO_PRIORITY=1
AUDIO_PRIORITY_GRACE_SECONDS=10
AUDIO_PRIORITY_RESUME_SPOTIFY=0

# How long the health check tolerates a failure that has its own recovery loop
# (a rebuilding sink, a snapclient reconnecting) before reporting unhealthy.
HEALTHCHECK_TOLERANCE_SECONDS=600
# Hostname the health check resolves to prove DNS works. Defaults to a Spotify
# endpoint when ENABLE_SPOTIFY=1; set to a name this host must reach, or to
# "none" to skip the live lookup.
HEALTHCHECK_DNS_NAME=

SNAPCLIENT_EXTRA_ARGS=
SNAPSERVER_EXTRA_ARGS=
SPOTIFYD_EXTRA_ARGS=
UPMPDCLI_EXTRA_ARGS=
