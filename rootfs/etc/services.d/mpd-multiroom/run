#!/command/with-contenv bash
set -euo pipefail

if [ "${ENABLE_SNAPSERVER:-0}" != "1" ] || [ "${ENABLE_UPNP:-1}" != "1" ]; then
  echo "mpd-multiroom disabled"
  exec sleep infinity
fi

PULSE_SOCKET="${PULSE_RUNTIME_PATH:-/tmp/pulse}/native"

until [ -S "${PULSE_SOCKET}" ] && pactl info >/dev/null 2>&1; do
  echo "Waiting for PulseAudio..."
  sleep 1
done

# audio-priority tells this instance's streams apart from the room MPD
# by this property; it must match the jq filter there.
export PULSE_PROP="homophony.domain=multiroom"

exec mpd --no-daemon /etc/mpd-multiroom.conf
